	partition DimStore = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("LocalHost", "ContosoRetailDW", [Query="SELECT DS.[StoreKey]#(lf)      ,DS.[GeographyKey]#(lf)      ,DE.FirstName AS StoreManager#(lf)      ,DS.[StoreType]#(lf)      ,DS.[StoreName]#(lf)  FROM [ContosoRetailDW].[dbo].[DimStore] AS DS#(lf)  LEFT JOIN DimEmployee AS DE ON DS.[StoreManager] = DE.EmployeeKey"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"StoreKey", type text}, {"GeographyKey", type text}, {"StoreManager", type text}})
				in
				    #"Tipo Alterado"

